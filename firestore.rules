rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions (SRS §13.1) ───
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'admin';
    }

    function isProvider() {
      return isAuthenticated() && getRole() == 'provider';
    }

    function isYouth() {
      return isAuthenticated() && getRole() == 'youth';
    }

    function isActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // 1. Users collection rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Allow creation only if the user sets their own UID
      // and sets a valid role (youth or provider) and status (active)
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role in ['youth', 'provider']
        && request.resource.data.status == 'active';

      // Allow updates by owner (can't change role/uid) OR admin
      allow update: if (isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role)
        || isAdmin();
        
      allow delete: if false; // Users cannot be deleted directly
    }

    // 2. Youth Profiles collection rules
    match /youth_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    // 3. Jobs collection rules
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      
      // Allow creation if the provider ID matches and user is active, OR if user is an admin
      allow create: if (isAuthenticated() 
        && request.resource.data.providerId == request.auth.uid
        && isActive())
        || isAdmin();

      // Allow updates by the provider who created the job OR admin OR the accepted youth (can only close status)
      allow update: if (isAuthenticated() && (
        resource.data.providerId == request.auth.uid ||
        (
          (
            resource.data.get('acceptedYouthId', null) == request.auth.uid ||
            resource.data.get('acceptedYouthId', null) == null
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status == 'closed'
        )
      )) || isAdmin();
        
      allow delete: if (isAuthenticated()
        && resource.data.providerId == request.auth.uid)
        || isAdmin();
    }

    // 4. Applications collection rules
    match /applications/{applicationId} {
      // Allowed to read if youth who applied, provider who posted, or admin
      allow read: if isAuthenticated() && (
        resource.data.youthId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      ) || isAdmin();

      // Allowed to apply (create) if youth and active
      allow create: if isAuthenticated()
        && request.resource.data.youthId == request.auth.uid
        && isActive();

      // Allowed to update status (accept/reject) if provider, or withdraw if youth
      allow update: if isAuthenticated() && (
        resource.data.youthId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );

      allow delete: if isAuthenticated() && resource.data.youthId == request.auth.uid;
    }

    // 5. Ratings collection rules
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      
      // Allow creation if the rater ID matches and user is active
      allow create: if isAuthenticated()
        && request.resource.data.raterId == request.auth.uid
        && isActive();
        
      allow update, delete: if false; // Ratings are immutable
    }

    // 6. User Notifications sub-collection rules
    match /notifications/{userId} {
      allow read, write: if isOwner(userId);
      
      match /items/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 7. Skills Taxonomy collection (SRS §6.7)
    match /skills_taxonomy/{skillId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // Only admin can modify the taxonomy
    }

    // 8. Global Configuration collection
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /api_keys/{keyId} {
        allow read, write: if isAdmin();
      }
    }

    // 9. System Logs collection
    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true; // Allow client events to be logged, including bootstrapping logs
      allow update, delete: if false; // Logs are write-once/immutable
    }

    // 10. Admin invitations collection
    match /admin_invitations/{invitationId} {
      allow read, write: if isAdmin();
    }

    // 11. Transactions collection
    match /transactions/{transactionId} {
      allow read, write: if isAdmin();
    }
  }
}
