# ===================================================================
# Fursafy — Environment Variables
# ===================================================================
# Copy this file to `.env` and fill in your real values.
# NEVER commit the `.env` file — it is listed in .gitignore.
#
# For CI/CD (GitHub Actions), add these as repository secrets.
# For local development, pass them via --dart-define or use a .env loader.
# ===================================================================

# ======================== FIREBASE ========================
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here


# ======================== GOOGLE MAPS ========================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ======================== AFRICA'S TALKING (SMS/OTP) ========================
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key_here
